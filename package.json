{
  "name": "assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "ingest": "node dist/src/ingest.js",
    "ingest:dev": "ts-node src/ingest.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@huggingface/transformers": "^3.0.0",
    "@pay-lambda-digital/entities": "^1.2.2",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "groq-sdk": "^0.7.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "rate-limiter-flexible": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
