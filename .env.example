PORT=3001

DATABASE_URL=postgresql://user:password@localhost:5432/paydb
REDIS_URL=redis://localhost:6379

# Selects the AssistantProvider from src/llm/index.ts's registry. Currently only "groq" is
# implemented — add another provider file under src/llm/ and register it there to add more.
LLM_PROVIDER=groq

# Free tier: https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Requests per IP (anonymous) or per userId (signed-in) per window.
CHAT_RATE_LIMIT_POINTS=10
CHAT_RATE_LIMIT_DURATION_SECONDS=60

# Anonymous session memory TTL.
SESSION_TTL_SECONDS=3600
